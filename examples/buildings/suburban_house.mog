meta (name = "usa_suburban_house", description = "a typical USA suburban house with attached garage, porch, driveway, lawn, and gabled roofs", tags = ["architecture", "house", "suburban", "usa", "residential"], seed = "1778453749749783000", thinking = "high", prompt = "a typical usa suburban house", mogen_version = "0.1.5")

