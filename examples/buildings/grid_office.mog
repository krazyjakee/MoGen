// A grid-style office floorplan: 9 equal rooms in a 3×3 grid, lots of
// windows, soft "private offices away from the entrance" preference.

material "concrete" (color=[0.78, 0.78, 0.75], roughness=0.85)
material "carpet"   (color=[0.42, 0.40, 0.45], roughness=0.95)
material "glass_partition" (color=[0.85, 0.92, 0.95], roughness=0.2)

building "office" (
  seed=7,
  style="grid",
  floor_area=160,
  rooms=9,
  windows=12,
  entrances=1,
  ceiling_height=2.8,
  door_w=0.95,
  door_h=2.1,
  mat="concrete",
) {
  room_type "office"      (kind=staff_only, density=4, mat="carpet")
  room_type "meeting"     (kind=public,     density=2, mat="carpet")
  room_type "kitchenette" (kind=service,    density=1, mat="concrete")
  room_type "reception"   (kind=public,     density=1, mat="concrete")
  room_type "corridor"    (kind=public,     density=1, mat="concrete")

  adjacency "reception"   (adjacent_to=["corridor"])
  adjacency "kitchenette" (away_from=["meeting"])
}
