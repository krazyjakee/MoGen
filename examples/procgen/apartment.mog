// A small single-storey apartment built from `building`. The BSP layout
// splits the floorplate into adjacent rooms; soft adjacency rules keep
// the kitchen near the living room and bathrooms near the bedrooms. A
// real flat doesn't have a central corridor — interior doors thread
// directly between neighbouring rooms.

meta (mogen_version = "0.1.5")

material "warm_wood" (color=[0.55, 0.38, 0.22], roughness=0.75)
material "tile"      (color=[0.86, 0.86, 0.83], roughness=0.35)
material "oak"       (color=[0.62, 0.45, 0.28], roughness=0.7)
material "plaster"   (color=[0.92, 0.91, 0.88], roughness=0.85)
material "white_tile" (color=[0.95, 0.95, 0.95], roughness=0.3)

building "apartment" (
  seed=11,
  style="apartment-block",
  floor_area=85,
  rooms=7,
  windows=8,
  entrances=1,
  ceiling_height=2.6,
  debug_hide_roof=1,
  mat="plaster"
) {
  room_type "bedroom"  (kind=private, density=4, mat="warm_wood")
  room_type "kitchen"  (kind=service, density=2, mat="tile")
  room_type "living"   (kind=public,  density=3, mat="oak")
  room_type "bathroom" (kind=service, density=2, mat="white_tile")

  adjacency "kitchen"  (adjacent_to=["living"], away_from=["bedroom"])
  adjacency "bathroom" (adjacent_to=["bedroom"])
}
