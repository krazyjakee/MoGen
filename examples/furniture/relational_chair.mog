module "chair" (w=1,h=0.65,d=0.7,recline=12) {
  plane "floor" (size=[3,0,3],tags="floating")
  box "seat" (pos=[0,$h,0],size=[$w,0.1,$d]) {
    connector "left_front" (at=[0-$w/2+0.08,-0.05,0-$d/2+0.08],dir=[0,-1,0])
    connector "left_rear" (at=[0-$w/2+0.08,-0.05,$d/2-0.08],dir=[0,-1,0])
    connector "right_front" (at=[$w/2-0.08,-0.05,0-$d/2+0.08],dir=[0,-1,0])
    connector "right_rear" (at=[$w/2-0.08,-0.05,$d/2-0.08],dir=[0,-1,0])
  }
  box "back" (pos=[0,$h+0.35,$d/2-0.05],size=[$w,0.7,0.08],rot=[$recline,0,0])
  box "foot_left_front" (pos=[0-$w/2+0.08,0,0-$d/2+0.08],size=[0.08,0.04,0.08])
  spline_tube "leg_left_front" (points=[[0,0,0],[0,0.3,0]],radius=0.025)
  relate (child="foot_left_front",target="floor",mode="ground")
  relate (child="leg_left_front",target="foot_left_front",mode="endpoint",endpoint="start",socket="top")
  relate (child="leg_left_front",target="seat",mode="endpoint",endpoint="end",socket="left_front",insertion=0.015)
  box "foot_left_rear" (pos=[0-$w/2+0.08,0,$d/2-0.08],size=[0.08,0.04,0.08])
  spline_tube "leg_left_rear" (points=[[0,0,0],[0,0.3,0]],radius=0.025)
  relate (child="foot_left_rear",target="floor",mode="ground")
  relate (child="leg_left_rear",target="foot_left_rear",mode="endpoint",endpoint="start",socket="top")
  relate (child="leg_left_rear",target="seat",mode="endpoint",endpoint="end",socket="left_rear",insertion=0.015)
  box "foot_right_front" (pos=[$w/2-0.08,0,0-$d/2+0.08],size=[0.08,0.04,0.08])
  spline_tube "leg_right_front" (points=[[0,0,0],[0,0.3,0]],radius=0.025)
  relate (child="foot_right_front",target="floor",mode="ground")
  relate (child="leg_right_front",target="foot_right_front",mode="endpoint",endpoint="start",socket="top")
  relate (child="leg_right_front",target="seat",mode="endpoint",endpoint="end",socket="right_front",insertion=0.015)
  box "foot_right_rear" (pos=[$w/2-0.08,0,$d/2-0.08],size=[0.08,0.04,0.08])
  spline_tube "leg_right_rear" (points=[[0,0,0],[0,0.3,0]],radius=0.025)
  relate (child="foot_right_rear",target="floor",mode="ground")
  relate (child="leg_right_rear",target="foot_right_rear",mode="endpoint",endpoint="start",socket="top")
  relate (child="leg_right_rear",target="seat",mode="endpoint",endpoint="end",socket="right_rear",insertion=0.015)
  box "support_left" (size=[0.05,0.2,0.05])
  relate (child="support_left",target="seat",mode="align",offset=[0-$w/2+0.08,0,0])
  sweep "arm_left" (profile=[[-0.06,-0.025],[0.06,-0.025],[0.06,0.025],[-0.06,0.025]],path=[[0,0,-0.25],[0,0,0.25]],frame_up=[0,1,0])
  relate (child="arm_left",target="support_left",mode="endpoint",endpoint="start",socket="top",offset=[0,0,-0.25])
  relate (child="arm_left",target="support_left",mode="endpoint",endpoint="end",socket="top",offset=[0,0,0.25])
  box "support_right" (size=[0.05,0.2,0.05])
  relate (child="support_right",target="seat",mode="align",offset=[$w/2-0.08,0,0])
  sweep "arm_right" (profile=[[-0.06,-0.025],[0.06,-0.025],[0.06,0.025],[-0.06,0.025]],path=[[0,0,-0.25],[0,0,0.25]],frame_up=[0,1,0])
  relate (child="arm_right",target="support_right",mode="endpoint",endpoint="start",socket="top",offset=[0,0,-0.25])
  relate (child="arm_right",target="support_right",mode="endpoint",endpoint="end",socket="top",offset=[0,0,0.25])
}
scene { use "chair" () }
