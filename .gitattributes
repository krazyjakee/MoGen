# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text types
*.rs        text diff=rust
*.toml      text
*.md        text
*.sh        text eol=lf
*.mg        text
*.json      text
*.yaml      text
*.yml       text

# Explicit binary (no diff, no eol conversion)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.mp4       binary

# 3D assets -- tracked via Git LFS
*.glb       filter=lfs diff=lfs merge=lfs -text
*.gltf      filter=lfs diff=lfs merge=lfs -text
*.bin       filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.obj       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.blend1    filter=lfs diff=lfs merge=lfs -text
*.ktx2      filter=lfs diff=lfs merge=lfs -text
*.dds       filter=lfs diff=lfs merge=lfs -text
*.exr       filter=lfs diff=lfs merge=lfs -text
*.hdr       filter=lfs diff=lfs merge=lfs -text

# Golden-GLB regression fixtures (see crates/mogen/tests/goldens.rs).
# Small, deterministic outputs of the compiler — kept in plain git so the
# test suite works without `git lfs pull` and CI doesn't depend on LFS.
crates/mogen/tests/fixtures/*.glb -filter -diff -merge binary
examples/furniture/chair.glb        -filter -diff -merge binary
examples/furniture/chair_mat.glb    -filter -diff -merge binary
examples/furniture/chair_array.glb  -filter -diff -merge binary
examples/furniture/chair_module.glb -filter -diff -merge binary
examples/furniture/table.glb        -filter -diff -merge binary
examples/weapons/sword.glb          -filter -diff -merge binary
examples/vehicles/drone.glb         -filter -diff -merge binary
examples/buildings/simple_house.glb -filter -diff -merge binary
examples/features/coil_spring.glb        -filter -diff -merge binary
examples/features/bezier_fender.glb      -filter -diff -merge binary
examples/features/units_blueprint.glb    -filter -diff -merge binary
examples/nature/wave_water.glb           -filter -diff -merge binary
examples/nature/heightfield_terrain.glb  -filter -diff -merge binary
examples/nature/metaball_blob.glb        -filter -diff -merge binary

# Godot-adjacent binary assets (the repo lives under godot-projects/)
*.tres      text
*.tscn      text
*.gd        text
*.import    text
*.godot     text
*.scn       filter=lfs diff=lfs merge=lfs -text
*.res       filter=lfs diff=lfs merge=lfs -text

# Lockfiles: let GitHub collapse them in diffs
Cargo.lock  linguist-generated=true
