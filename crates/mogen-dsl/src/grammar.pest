WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }

bom_ = _{ "\u{feff}" }
file = { SOI ~ bom_? ~ node* ~ EOI }

node = { ident ~ name? ~ attr_list? ~ block? }

name  = { string }
block = { "{" ~ node* ~ "}" }

attr_list = { "(" ~ (attr ~ ("," ~ attr)*)? ~ ","? ~ ")" }
attr      = { ident ~ "=" ~ value }

value = { gradient | vec3 | list | expr | string | ident }

// Surface gradient syntax: `linear(from=[1,0,0], to=[0,0,1], axis=y)`. The
// argument list reuses `attr_list` so the parser machinery for `(k=v, …)`
// drops in unchanged; lowering interprets the keys per gradient kind.
gradient      = { gradient_kind ~ attr_list }
gradient_kind = { "linear" | "vertical" | "radial" | "stops" }

vec3      = { "[" ~ expr ~ "," ~ expr ~ "," ~ expr ~ "]" }
list      = { "[" ~ (list_item ~ ("," ~ list_item)*)? ~ ","? ~ "]" }
list_item = { vec3 | list | face_call | string | expr }

// Per-face UV struct for `box (faces=[…])`: a material string plus optional
// authored UV transform. `face("wood", uv_scale=[1,1], uv_offset=[0,0],
// uv_swap=false)`. The named args reuse `attr`; lowering reads uv_scale /
// uv_offset (2-number lists) and uv_swap (true/false ident). A `face("mat")`
// with no UV args is equivalent to the bare `"mat"` string.
face_call = { "face" ~ "(" ~ string ~ ("," ~ attr)* ~ ","? ~ ")" }

expr   =  { sum ~ (cmp_op ~ sum)? }
sum    =  { term ~ (add_op ~ term)* }
term   =  { factor ~ (mul_op ~ factor)* }
factor =  { number | param_ref | "(" ~ expr ~ ")" }
add_op =  { "+" | "-" }
mul_op =  { "*" | "/" }
// Order matters: 2-char operators must precede their 1-char prefixes so
// `<=` doesn't get tokenised as `<` followed by `=`.
cmp_op =  { "<=" | ">=" | "==" | "!=" | "<" | ">" }

// A numeric literal may carry an optional unit suffix. Two dimensions are
// recognised, both normalised to their base unit at parse time so the rest of
// the pipeline only ever sees plain `f32`:
//   * length → metres     (`1.5m`, `18in`, `90cm`; bare = metres)
//   * weight → kilograms   (`5kg`, `180lb`, `2t`; a mass) and its per-volume
//                           form `700kg/m3` → kilograms per cubic metre (a
//                           "weight per cubic metre", i.e. density).
// Order matters. `density_unit` precedes `mass_unit` so `kg/m3` is taken whole
// rather than as `kg` with a dangling `/m3`. The two-letter length units that
// share a prefix with `m` (`mm`, `cm`, `km`) must precede `m`. Mass and length
// suffixes are disjoint, so a literal is unambiguous.
number    = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ unit? }
unit        = @{ density_unit | mass_unit | length_unit }
density_unit = @{ mass_unit ~ "/" ~ ("m3" | "m³") }
mass_unit   = @{ "kg" | "g" | "t" | "lb" | "oz" | "st" }
length_unit = @{ "mm" | "cm" | "km" | "m" | "in" | "ft" | "yd" }
// A backslash escapes the next character, so `\"` embeds a quote and `\\` a
// backslash. Needed for JSON payloads in `extras=`. Other escapes pass through
// verbatim (see `unquote` in parser.rs) so texture paths keep working.
string    = @{ "\"" ~ ("\\" ~ ANY | !"\"" ~ ANY)* ~ "\"" }
ident     = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
param_ref = @{ "$" ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
