WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }

bom_ = _{ "\u{feff}" }
file = { SOI ~ bom_? ~ node* ~ EOI }

node = { ident ~ name? ~ attr_list? ~ block? }

name  = { string }
block = { "{" ~ node* ~ "}" }

attr_list = { "(" ~ (attr ~ ("," ~ attr)*)? ~ ","? ~ ")" }
attr      = { ident ~ "=" ~ value }

value = { gradient | vec3 | list | expr | string | ident }

// Surface gradient syntax: `linear(from=[1,0,0], to=[0,0,1], axis=y)`. The
// argument list reuses `attr_list` so the parser machinery for `(k=v, …)`
// drops in unchanged; lowering interprets the keys per gradient kind.
gradient      = { gradient_kind ~ attr_list }
gradient_kind = { "linear" | "vertical" | "radial" | "stops" }

vec3      = { "[" ~ expr ~ "," ~ expr ~ "," ~ expr ~ "]" }
list      = { "[" ~ (list_item ~ ("," ~ list_item)*)? ~ ","? ~ "]" }
list_item = { vec3 | list | string | expr }

expr   =  { sum ~ (cmp_op ~ sum)? }
sum    =  { term ~ (add_op ~ term)* }
term   =  { factor ~ (mul_op ~ factor)* }
factor =  { number | param_ref | "(" ~ expr ~ ")" }
add_op =  { "+" | "-" }
mul_op =  { "*" | "/" }
// Order matters: 2-char operators must precede their 1-char prefixes so
// `<=` doesn't get tokenised as `<` followed by `=`.
cmp_op =  { "<=" | ">=" | "==" | "!=" | "<" | ">" }

number    = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
string    = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
ident     = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
param_ref = @{ "$" ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
