// summary: Short beard / stubble cluster on the jaw — three thin chamfered_boxes (chin block plus left/right sideburns) layered over the lower face of `humanoid_full`. All three skin to the `rig` skeleton and rigid-bind to `neck` so the beard tracks head turns through the walk / run / idle / jump clips. Pass `height` matching the host `humanoid_full`; `colour` typically matches the figure's `hair` parameter and drives the `beard_hair` material. Use after `humanoid_full ()` in the same scene.
module "humanoid_beard_short" (
  height=1.7,
  colour=[0.20, 0.15, 0.10]
) {
  material "beard_hair" (color=$colour, roughness=0.88)

  // Chin block — sits below the mouth so it doesn't obscure it; covers
  // the lower-front of the jaw.
  chamfered_box "beard_chin" (
    pos=[0, $height * 0.846, $height * -0.057],
    size=[$height * 0.080, $height * 0.028, $height * 0.022],
    radius=$height * 0.004,
    mat="beard_hair", skin="rig", bind="neck", faceted=1
  )

  // Sideburns — narrow vertical stripes on each side of the jaw,
  // stretching from the cheek down toward the jawline.
  chamfered_box "beard_sideburn_l" (
    pos=[$height *  0.046, $height * 0.870, $height * -0.040],
    size=[$height * 0.018, $height * 0.054, $height * 0.022],
    radius=$height * 0.003,
    mat="beard_hair", skin="rig", bind="neck", faceted=1
  )
  chamfered_box "beard_sideburn_r" (
    pos=[$height * -0.046, $height * 0.870, $height * -0.040],
    size=[$height * 0.018, $height * 0.054, $height * 0.022],
    radius=$height * 0.003,
    mat="beard_hair", skin="rig", bind="neck", faceted=1
  )
}
