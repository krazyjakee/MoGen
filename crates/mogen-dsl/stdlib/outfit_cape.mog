// summary: Shoulder cape (thin chamfered_box drape) for humanoid_full. Hangs vertically from the upper back down to mid-thigh, follows the chest bone via skinning. Color param defaults to a deep crimson. Pair with `outfit_helmet` for a knight, `outfit_hat_brimmed` for a wanderer.
module "outfit_cape" (
  height=1.7,
  color=[0.55, 0.10, 0.10]
) {
  material "outfit_cape" (color=$color, roughness=0.85)

  // Thin chamfered_box hung behind the torso, top aligned with the
  // shoulders, bottom just above mid-thigh. Bound to spine_chest so it
  // sways with the upper body during animation.
  group "outfit_cape" (skin="rig", bind="spine_chest") {
    chamfered_box "outfit_cape_drape" (
      pos=[0, $height * 0.555, $height * 0.075],
      size=[$height * 0.300, $height * 0.450, $height * 0.015],
      radius=$height * 0.005,
      mat="outfit_cape", faceted=1
    )
  }
}
