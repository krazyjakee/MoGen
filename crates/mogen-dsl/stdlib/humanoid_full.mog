// summary: Complete rigged Synty/Quaternius-style low-poly humanoid in one declaration. Faceted chamfered-box body, mitten hands, painted face panel. All colours pass-through as vec3 params (`skin`, `hair`, `eye`, `mouth`, `shirt`, `pants`, `boot`, `face`) — the module declares matching materials internally so a bare `use "humanoid_full" ()` produces a fully-coloured character. Skeleton is 17 bones (`hip`, `spine_lower`, `spine_mid`, `spine_chest`, `neck`, `shoulder_l/r`, `elbow_l/r`, `wrist_l/r`, `hip_l/r`, `knee_l/r`, `ankle_l/r`, `toe_l/r`) named to drive `humanoid_walk` / `humanoid_run` / `humanoid_idle` / `humanoid_jump` clips. Outfit modules (`outfit_shirt`, `outfit_helmet`, `equip_sword`, …) socket-snap to the figure's `crown`, `back`, `waist`, `shoulder_back`, `wrist_l_grip`, `wrist_r_grip` connectors. Use only ONCE per scene (single "rig" skeleton).
module "humanoid_full" (
  height=1.7,
  skin =[0.85, 0.65, 0.55],
  hair =[0.20, 0.15, 0.10],
  eye  =[0.08, 0.08, 0.10],
  mouth=[0.55, 0.20, 0.20],
  shirt=[0.30, 0.45, 0.65],
  pants=[0.20, 0.22, 0.28],
  boot =[0.15, 0.10, 0.07],
  face =[0.92, 0.72, 0.62]
) {
  // ---------- Materials (internal defaults; caller-declared materials win) ----------
  // The material-collector dedupes by name with first-wins semantics, so a
  // user-supplied `material "skin" (...)` at the top of the scene overrides
  // any of these. The `face` material is special — when the texture pipeline
  // runs, its prompt is character-specific (eyes/brows/mouth painted on a
  // flat panel) so the LLM can supply a face texture without the caller
  // doing anything beyond `mogen textures`.
  material "skin"  (color=$skin,  roughness=0.75)
  material "hair"  (color=$hair,  roughness=0.85)
  material "eye"   (color=$eye,   roughness=0.30)
  material "mouth" (color=$mouth, roughness=0.55)
  material "shirt" (color=$shirt, roughness=0.80)
  material "pants" (color=$pants, roughness=0.85)
  material "boot"  (color=$boot,  roughness=0.70)
  material "face"  (color=$face,  roughness=0.65)

  // ---------- Skeleton ----------
  // 17 bones. spine is split into spine_lower/spine_mid/spine_chest so all
  // four shipped clips drive bones that exist (idle references spine_chest,
  // walk/run reference spine_mid, run/jump reference spine_lower). Toe leaves
  // on the feet pick up walk's toe_l/toe_r tracks. Bone offsets are
  // parent-relative; envelopes are sized so neighbouring bones overlap at
  // joints (rule of thumb: envelope ≈ 0.7× the bone's own length) so the
  // linear distance/envelope falloff doesn't leave a "dead zone" mid-limb.
  skeleton "rig" (pos=[0, $height * 0.55, 0]) {
    bone "hip" (pos=[0, 0, 0], envelope=$height * 0.13) {
      bone "spine_lower" (pos=[0, $height * 0.06, 0], envelope=$height * 0.10) {
        bone "spine_mid" (pos=[0, $height * 0.06, 0], envelope=$height * 0.10) {
          bone "spine_chest" (pos=[0, $height * 0.06, 0], envelope=$height * 0.12) {
            bone "neck" (pos=[0, $height * 0.13, 0], envelope=$height * 0.10)
            bone "shoulder_l" (pos=[ $height * 0.115, $height * 0.04, 0], envelope=$height * 0.14) {
              bone "elbow_l" (pos=[$height *  0.0513, $height * -0.1410, 0], envelope=$height * 0.16) {
                bone "wrist_l" (pos=[$height *  0.0547, $height * -0.1504, 0], envelope=$height * 0.10)
              }
            }
            bone "shoulder_r" (pos=[$height * -0.115, $height * 0.04, 0], envelope=$height * 0.14) {
              bone "elbow_r" (pos=[$height * -0.0513, $height * -0.1410, 0], envelope=$height * 0.16) {
                bone "wrist_r" (pos=[$height * -0.0547, $height * -0.1504, 0], envelope=$height * 0.10)
              }
            }
          }
        }
      }
      bone "hip_l" (pos=[ $height * 0.06, 0, 0], envelope=$height * 0.18) {
        bone "knee_l" (pos=[0, $height * -0.24, 0], envelope=$height * 0.18) {
          bone "ankle_l" (pos=[0, $height * -0.24, 0], envelope=$height * 0.10) {
            bone "toe_l" (pos=[0, 0, $height * -0.07], envelope=$height * 0.06)
          }
        }
      }
      bone "hip_r" (pos=[$height * -0.06, 0, 0], envelope=$height * 0.18) {
        bone "knee_r" (pos=[0, $height * -0.24, 0], envelope=$height * 0.18) {
          bone "ankle_r" (pos=[0, $height * -0.24, 0], envelope=$height * 0.10) {
            bone "toe_r" (pos=[0, 0, $height * -0.07], envelope=$height * 0.06)
          }
        }
      }
    }
  }

  // ---------- Geometry ----------
  // Each part sits at its rest world position (the position of the bone it
  // skins to). At runtime, skinning + bone animations drive deformation; the
  // scene-tree parent of each part is the scene root, NOT another part. We
  // use explicit `pos=` rather than connector-`attach` chains because the
  // chain would have to traverse multiple modules to wire face/nose/brow
  // onto the head, and explicit world positions are easier to read and
  // tweak. Outfit modules use connectors+attach to snap to the figure.

  // Torso (shirt material). Carries figure-level sockets for outfits.
  chamfered_box "torso" (
    pos=[0, $height * 0.70, 0],
    size=[$height * 0.21, $height * 0.20, $height * 0.12],
    radius=$height * 0.012,
    mat="shirt", skin="rig", bind="spine_chest", faceted=1
  ) {
    connector "neck"          (at=[0,                  $height *  0.10, 0],               dir=[0,  1, 0], tag=neck)
    connector "back"          (at=[0,                  0,               $height *  0.06], dir=[0,  0, 1], tag=back)
    connector "shoulder_back" (at=[0,                  $height *  0.07, $height *  0.06], dir=[0,  0, 1], tag=shoulder_back)
  }

  // Hips (pants material). Carries leg sockets and waist socket.
  chamfered_box "hips" (
    pos=[0, $height * 0.555, 0],
    size=[$height * 0.20, $height * 0.07, $height * 0.12],
    radius=$height * 0.012,
    mat="pants", skin="rig", bind="hip", faceted=1
  ) {
    connector "waist" (at=[0, $height * 0.035, 0], dir=[0, 1, 0], tag=waist)
  }

  // Head (skin material). Single chamfered_box block — the cranium.
  chamfered_box "head" (
    pos=[0, $height * 0.920, 0],
    size=[$height * 0.105, $height * 0.118, $height * 0.105],
    radius=$height * 0.010,
    mat="skin", skin="rig", bind="neck", faceted=1
  ) {
    connector "crown" (at=[0,                $height *  0.059, 0],               dir=[0,  1, 0], tag=crown)
    connector "ear_l" (at=[$height *  0.052, 0,                0],               dir=[ 1, 0, 0], tag=ear)
    connector "ear_r" (at=[$height * -0.052, 0,                0],               dir=[-1, 0, 0], tag=ear)
    connector "face"  (at=[0,                0,                $height * -0.052], dir=[0,  0, -1], tag=face)
  }

  // Hybrid face: subtle nose/brow geometry + flat painted face panel.
  // Painted on a quad sitting just in front of the head's front face (-Z
  // forward in glTF). Quad is NOT unioned with the head — CSG strips UVs,
  // and the panel needs a clean [0,1]² UV layout for the texture pipeline.
  quad "face_panel" (
    pos=[0, $height * 0.920, $height * -0.054],
    size=[$height * 0.090, $height * 0.082],
    mat="face", uv_mode="fit", skin="rig", bind="neck", faceted=1
  )
  // Nose: small chamfered_box protruding forward (-Z) from the face center.
  chamfered_box "nose" (
    pos=[0, $height * 0.915, $height * -0.062],
    size=[$height * 0.014, $height * 0.025, $height * 0.022],
    radius=$height * 0.004,
    mat="skin", skin="rig", bind="neck", faceted=1
  )
  // Brow ridge: thin chamfered_box across the upper face.
  chamfered_box "brow" (
    pos=[0, $height * 0.945, $height * -0.058],
    size=[$height * 0.080, $height * 0.012, $height * 0.014],
    radius=$height * 0.003,
    mat="skin", skin="rig", bind="neck", faceted=1
  )

  // Arms: wrapping `group` so the two chamfered_boxes share skin attrs and
  // expose a single `shoulder` socket for outfit attaches at the shoulder.
  // No `bind` — envelope skinning lets shoulder_l/elbow_l/wrist_l blend
  // smoothly along the arm. Arm origin is at the shoulder bone's world
  // position; geometry hangs in -Y from there.
  group "arm_l" (pos=[$height *  0.115, $height * 0.77, 0], skin="rig") {
    chamfered_box "arm_l_upper" (
      pos=[0, $height * -0.072, 0],
      size=[$height * 0.045, $height * 0.150, $height * 0.045],
      radius=$height * 0.008,
      mat="skin", faceted=1
    )
    chamfered_box "arm_l_fore" (
      pos=[0, $height * -0.224, 0],
      size=[$height * 0.040, $height * 0.150, $height * 0.040],
      radius=$height * 0.007,
      mat="skin", faceted=1
    )
    connector "shoulder" (at=[0, 0,                0], dir=[0,  1, 0], tag=shoulder)
  }
  group "arm_r" (pos=[$height * -0.115, $height * 0.77, 0], skin="rig") {
    chamfered_box "arm_r_upper" (
      pos=[0, $height * -0.072, 0],
      size=[$height * 0.045, $height * 0.150, $height * 0.045],
      radius=$height * 0.008,
      mat="skin", faceted=1
    )
    chamfered_box "arm_r_fore" (
      pos=[0, $height * -0.224, 0],
      size=[$height * 0.040, $height * 0.150, $height * 0.040],
      radius=$height * 0.007,
      mat="skin", faceted=1
    )
    connector "shoulder" (at=[0, 0,                0], dir=[0,  1, 0], tag=shoulder)
  }

  // Hands: Synty mitten — palm chamfered_box + small thumb stub.
  // 5-finger geometry is gone — at Synty silhouette scale fingers disappear
  // and double the vertex count. The grip connector is what equip_sword /
  // equip_shield / equip_staff snap to.
  group "hand_l" (pos=[$height *  0.155, $height * 0.47, 0], skin="rig", bind="wrist_l") {
    chamfered_box "hand_l_palm" (
      pos=[0, $height * -0.030, 0],
      size=[$height * 0.030, $height * 0.060, $height * 0.045],
      radius=$height * 0.006,
      mat="skin", faceted=1
    )
    chamfered_box "hand_l_thumb" (
      pos=[$height * -0.022, $height * -0.018, 0],
      size=[$height * 0.018, $height * 0.030, $height * 0.020],
      radius=$height * 0.004,
      mat="skin", faceted=1
    )
    connector "wrist_l_grip" (at=[$height *  0.005, $height * -0.030, 0], dir=[0, -1, 0], tag=grip)
  }
  group "hand_r" (pos=[$height * -0.155, $height * 0.47, 0], skin="rig", bind="wrist_r") {
    chamfered_box "hand_r_palm" (
      pos=[0, $height * -0.030, 0],
      size=[$height * 0.030, $height * 0.060, $height * 0.045],
      radius=$height * 0.006,
      mat="skin", faceted=1
    )
    chamfered_box "hand_r_thumb" (
      pos=[$height *  0.022, $height * -0.018, 0],
      size=[$height * 0.018, $height * 0.030, $height * 0.020],
      radius=$height * 0.004,
      mat="skin", faceted=1
    )
    connector "wrist_r_grip" (at=[$height * -0.005, $height * -0.030, 0], dir=[0, -1, 0], tag=grip)
  }

  // Legs (pants material). Envelope-skinned so hip_l/knee_l/ankle_l blend.
  group "leg_l" (pos=[$height *  0.06, $height * 0.55, 0], skin="rig") {
    chamfered_box "leg_l_thigh" (
      pos=[0, $height * -0.120, 0],
      size=[$height * 0.058, $height * 0.240, $height * 0.058],
      radius=$height * 0.009,
      mat="pants", faceted=1
    )
    chamfered_box "leg_l_shin" (
      pos=[0, $height * -0.360, 0],
      size=[$height * 0.050, $height * 0.240, $height * 0.050],
      radius=$height * 0.008,
      mat="pants", faceted=1
    )
  }
  group "leg_r" (pos=[$height * -0.06, $height * 0.55, 0], skin="rig") {
    chamfered_box "leg_r_thigh" (
      pos=[0, $height * -0.120, 0],
      size=[$height * 0.058, $height * 0.240, $height * 0.058],
      radius=$height * 0.009,
      mat="pants", faceted=1
    )
    chamfered_box "leg_r_shin" (
      pos=[0, $height * -0.360, 0],
      size=[$height * 0.050, $height * 0.240, $height * 0.050],
      radius=$height * 0.008,
      mat="pants", faceted=1
    )
  }

  // Feet (boot material). Single chunky chamfered_box per foot. The toe_l/r
  // bone drives the front part via envelope overlap.
  chamfered_box "foot_l" (
    pos=[$height *  0.06, $height * 0.05, $height * -0.025],
    size=[$height * 0.060, $height * 0.040, $height * 0.130],
    radius=$height * 0.008,
    mat="boot", skin="rig", bind="ankle_l", faceted=1
  )
  chamfered_box "foot_r" (
    pos=[$height * -0.06, $height * 0.05, $height * -0.025],
    size=[$height * 0.060, $height * 0.040, $height * 0.130],
    radius=$height * 0.008,
    mat="boot", skin="rig", bind="ankle_r", faceted=1
  )
}
