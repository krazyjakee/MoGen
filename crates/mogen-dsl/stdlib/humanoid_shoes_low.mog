// summary: Low-profile dress shoes layered over `humanoid_full`'s feet. Four chamfered_box panels — a main shoe shell over each foot (rigid-bound to `ankle_l/r`) plus a forward toe cap (rigid-bound to `toe_l/r`) so the toe flexes during walk and run cycles. Each piece is sized 4 mm wider than the bare foot so the shoe reads as a distinct shell over the boot mesh. Pass `height` matching the host `humanoid_full`; `colour` defaults to near-black and drives the `dress_shoe` material. Use after `humanoid_full ()` in the same scene.
module "humanoid_shoes_low" (
  height=1.7,
  colour=[0.04, 0.04, 0.04]
) {
  material "dress_shoe" (color=$colour, roughness=0.55, metallic=0.05)

  chamfered_box "shoe_l" (
    pos=[$height *  0.060, $height * 0.027, $height * -0.010],
    size=[$height * 0.078, $height * 0.054, $height * 0.130],
    radius=$height * 0.010,
    mat="dress_shoe", skin="rig", bind="ankle_l", faceted=1
  )
  chamfered_box "shoe_r" (
    pos=[$height * -0.060, $height * 0.027, $height * -0.010],
    size=[$height * 0.078, $height * 0.054, $height * 0.130],
    radius=$height * 0.010,
    mat="dress_shoe", skin="rig", bind="ankle_r", faceted=1
  )

  // Toe caps bound to toe_l/r so they bend with the toe bone during the
  // mid-stance toe flex of the walk / run cycle.
  chamfered_box "shoe_l_toe" (
    pos=[$height *  0.060, $height * 0.022, $height * -0.105],
    size=[$height * 0.072, $height * 0.044, $height * 0.044],
    radius=$height * 0.012,
    mat="dress_shoe", skin="rig", bind="toe_l", faceted=1
  )
  chamfered_box "shoe_r_toe" (
    pos=[$height * -0.060, $height * 0.022, $height * -0.105],
    size=[$height * 0.072, $height * 0.044, $height * 0.044],
    radius=$height * 0.012,
    mat="dress_shoe", skin="rig", bind="toe_r", faceted=1
  )
}
