// summary: Scale band — wraparound array of curved-plane scales for snake / fish / dragon skin. `count` scales encircle Y at `ring_radius`, each cupped outward (+X). Pair with a scale material (`double_sided=1`). Default 12 scales of 0.04 × 0.06m on a 0.06m ring. Stack multiple bands along Y for a full body.
module "scale_band" (count=12, ring_radius=0.06, scale_w=0.04, scale_h=0.06) {
  array "scale_band" (count=$count, around=y) {
    curved_plane "scale" (
      pos=[$ring_radius, 0, 0],
      rot=[0, 90, 0],
      size=[$scale_w, $scale_h],
      bend_u=40, bend_v=0,
      segments_u=4, segments_v=2
    )
  }
}
