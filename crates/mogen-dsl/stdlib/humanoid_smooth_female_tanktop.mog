// summary: Imported humanoid mesh (Smooth Female Tanktop) — 10 body-part GLBs grouped under one node, all using the caller-declared "skin" material. `scale` (default 1.0) uniformly resizes the figure; meshes are pre-baked from the source artwork with the hip near origin.
module "humanoid_smooth_female_tanktop" (scale=1.0) {
  group "humanoid_smooth_female_tanktop" (scale=$scale, mat="skin") {
    mesh "head" (src="stdlib:humanoid/head_smooth_female_tanktop.glb")
    mesh "torso" (src="stdlib:humanoid/torso_smooth_female_tanktop.glb")
    mesh "arm_l" (src="stdlib:humanoid/arm_l_smooth_female_tanktop.glb")
    mesh "arm_r" (src="stdlib:humanoid/arm_r_smooth_female_tanktop.glb")
    mesh "hand_l" (src="stdlib:humanoid/hand_l_smooth_female_tanktop.glb")
    mesh "hand_r" (src="stdlib:humanoid/hand_r_smooth_female_tanktop.glb")
    mesh "leg_l" (src="stdlib:humanoid/leg_l_smooth_female_tanktop.glb")
    mesh "leg_r" (src="stdlib:humanoid/leg_r_smooth_female_tanktop.glb")
    mesh "foot_l" (src="stdlib:humanoid/foot_l_smooth_female_tanktop.glb")
    mesh "foot_r" (src="stdlib:humanoid/foot_r_smooth_female_tanktop.glb")
  }
}
