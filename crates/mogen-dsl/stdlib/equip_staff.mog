// summary: Staff (long cylindrical shaft + crystal/stone finial) for humanoid_full. Snaps into the right hand's `wrist_r_grip` socket and follows the wrist_r bone. `wood_color` is the shaft, `crystal_color` the head — defaults read as wizard / mage.
module "equip_staff" (
  height=1.7,
  wood_color   =[0.34, 0.22, 0.14],
  crystal_color=[0.40, 0.70, 0.92]
) {
  material "equip_staff_wood"    (color=$wood_color,    roughness=0.85)
  material "equip_staff_crystal" (color=$crystal_color, roughness=0.20, emissive=$crystal_color, emissive_strength=0.8)

  // Staff held vertically at the right hand: shaft hangs in +Y above and
  // -Y below the grip, crystal sits at the top. Bound to wrist_r.
  group "equip_staff" (pos=[$height * -0.155, $height * 0.40, 0], skin="rig", bind="wrist_r") {
    // Shaft — long cylinder centred at the grip, extending up and down.
    cylinder "equip_staff_shaft" (
      pos=[0, $height * 0.140, 0],
      radius=$height * 0.014,
      height=$height * 0.700,
      segments=10,
      mat="equip_staff_wood", faceted=1
    )
    // Crystal finial — small chamfered_box near the top.
    chamfered_box "equip_staff_crystal" (
      pos=[0, $height * 0.510, 0],
      size=[$height * 0.045, $height * 0.060, $height * 0.045],
      radius=$height * 0.012,
      mat="equip_staff_crystal", faceted=1
    )
  }
}
