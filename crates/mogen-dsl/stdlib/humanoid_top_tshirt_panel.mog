// summary: Visible undershirt / t-shirt panel that fills the V-shaped gap left by `humanoid_top_blazer_open` at the upper chest. One thin chamfered_box on the chest front, skinned to the `rig` skeleton and rigid-bound to `spine_chest` so it tracks torso twist with the jacket. Pass `height` and `weight` matching the host `humanoid_full` call; `colour` defaults to off-white for a typical dress shirt and drives the `undershirt` material. Use after `humanoid_full ()` and (typically) `humanoid_top_blazer_open ()` in the same scene.
module "humanoid_top_tshirt_panel" (
  height=1.7,
  weight=1.0,
  colour=[0.95, 0.95, 0.95]
) {
  material "undershirt" (color=$colour, roughness=0.82)

  // Inner edges of `humanoid_top_blazer_open`'s lapels sit ~3.5 % of
  // height in from the chest centre, so this panel is sized to fill the
  // V gap and pushed in front of the lapel surfaces (which span
  // z ≈ -0.122 .. -0.090 at $height=1.75, $weight=0.95) so the white
  // shirt clearly reads against the dark jacket fabric.
  chamfered_box "tshirt_panel" (
    pos=[0, $height * 0.730, $height * -0.080 * $weight],
    size=[$height * 0.064 * $weight, $height * 0.150, $height * 0.020],
    radius=$height * 0.005,
    mat="undershirt", skin="rig", bind="spine_chest", faceted=1
  )
}
