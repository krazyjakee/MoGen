// summary: Long hair — skullcap + back-falling drape past the shoulders. Sits on `humanoid_head` (`crown` socket). Caller declares material `hair`.
module "humanoid_hair_long" (size=0.115, length=0.45) {
  union "hair" (smooth=0.02) {
    sphere "cap" (radius=$size, rings=10, segments=16, mat="hair")
    // Back drape: ellipsoid stretched downward behind the head and shoulders.
    ellipsoid "drape" (
      pos=[0, $length * -0.5 + $size * -0.1, $size * 0.35],
      size=[$size * 2.0, $length, $size * 1.1],
      mat="hair"
    )
    connector "crown" (at=[0, $size * -0.92, 0], dir=[0, -1, 0], tag=crown)
  }
}
