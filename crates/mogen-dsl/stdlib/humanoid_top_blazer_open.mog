// summary: Open-front business blazer / suit jacket layered over `humanoid_full`'s torso. Five chamfered_box panels (back, two side wraps, two front lapels with a Z-axis tilt) leave a V-shaped gap at the upper chest where an undershirt panel shows through, plus four chamfered_box sleeves over the upper and lower arms. Each piece skins to the `rig` skeleton declared by `humanoid_full` and rigid-binds to the matching bone (`spine_chest` for torso pieces, `shoulder_l/r` and `elbow_l/r` for sleeves) so the jacket follows walks, runs, idles, and jumps. Pass `height` and `weight` matching the host `humanoid_full` call; `colour` drives the jacket fabric material `jacket_outer`. Use after a `humanoid_full ()` call in the same scene.
module "humanoid_top_blazer_open" (
  height=1.7,
  weight=1.0,
  colour=[0.06, 0.06, 0.06]
) {
  material "jacket_outer" (color=$colour, roughness=0.78)

  // Back-and-sides shell — a single wide chamfered_box that wraps the
  // back ¾ of the torso (back face + sides + back-of-shoulders),
  // shifted rearward in Z so the front of the chest stays uncovered for
  // the lapels to sit on.
  chamfered_box "blazer_back_sides" (
    pos=[0, $height * 0.660, $height * 0.022],
    size=[$height * 0.226 * $weight, $height * 0.276, $height * 0.094 * $weight],
    radius=$height * 0.014,
    mat="jacket_outer", skin="rig", bind="spine_chest", faceted=1
  )

  // Front lapels — two flat panels offset off-centre so a V-shaped gap
  // runs down the chest centre. The undershirt panel below shows
  // through. Each lapel is shifted slightly forward of the body torso
  // surface so it reads as a separate jacket layer rather than blending
  // into the body mesh.
  chamfered_box "blazer_front_l" (
    pos=[$height * 0.062 * $weight, $height * 0.660, $height * -0.064 * $weight],
    size=[$height * 0.082 * $weight, $height * 0.276, $height * 0.018],
    radius=$height * 0.006,
    mat="jacket_outer", skin="rig", bind="spine_chest", faceted=1
  )
  chamfered_box "blazer_front_r" (
    pos=[$height * -0.062 * $weight, $height * 0.660, $height * -0.064 * $weight],
    size=[$height * 0.082 * $weight, $height * 0.276, $height * 0.018],
    radius=$height * 0.006,
    mat="jacket_outer", skin="rig", bind="spine_chest", faceted=1
  )

  // Sleeves — slightly larger than the bare arms so they envelop the
  // skin geometry. Bound to the arm bones so they swing through walks
  // / runs.
  chamfered_box "blazer_sleeve_l_upper" (
    pos=[$height *  0.135, $height * 0.695, 0],
    size=[$height * 0.052 * $weight, $height * 0.150, $height * 0.052 * $weight],
    radius=$height * 0.009,
    mat="jacket_outer", skin="rig", bind="shoulder_l", faceted=1
  )
  chamfered_box "blazer_sleeve_l_fore" (
    pos=[$height *  0.135, $height * 0.545, 0],
    size=[$height * 0.046 * $weight, $height * 0.150, $height * 0.046 * $weight],
    radius=$height * 0.008,
    mat="jacket_outer", skin="rig", bind="elbow_l", faceted=1
  )
  chamfered_box "blazer_sleeve_r_upper" (
    pos=[$height * -0.135, $height * 0.695, 0],
    size=[$height * 0.052 * $weight, $height * 0.150, $height * 0.052 * $weight],
    radius=$height * 0.009,
    mat="jacket_outer", skin="rig", bind="shoulder_r", faceted=1
  )
  chamfered_box "blazer_sleeve_r_fore" (
    pos=[$height * -0.135, $height * 0.545, 0],
    size=[$height * 0.046 * $weight, $height * 0.150, $height * 0.046 * $weight],
    radius=$height * 0.008,
    mat="jacket_outer", skin="rig", bind="elbow_r", faceted=1
  )
}
