// summary: Stepped taper — lathed column with 4 visible steps, base radius 0.5 → top radius 0.1 across height 1.0. Use for rocket nozzles, tapered chimneys, segmented pillars. Wrap in a group + `scale=` (or per-axis `w/h/d`) to resize; the profile is unitised so a single `scale` propagates uniformly.
module "step_taper" () {
  lathe "step_taper" (
    profile=[
      [0.5, 0.0],
      [0.5, 0.25],
      [0.4, 0.25],
      [0.4, 0.5],
      [0.3, 0.5],
      [0.3, 0.75],
      [0.2, 0.75],
      [0.2, 1.0],
      [0.1, 1.0]
    ],
    segments=24
  )
}
