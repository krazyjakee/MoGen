// summary: Layered outer-pants shell with optional ankle taper, slipped 2 mm outside `humanoid_full`'s built-in leg geometry so it reads as a distinct trouser layer over the bare-leg colour. Six chamfered_box panels: hip block, two thigh panels, two shin panels (which interpolate from current-shape at `taper=0` to ankle-width 60 % of thigh at `taper=1`), all skinned to the `rig` skeleton and rigid-bound to `hip` / `hip_l/r` / `knee_l/r` so the trousers follow walk / run / idle / jump. Pass `height` and `weight` matching the host `humanoid_full`; `colour` drives the `pants_outer` material; `taper` (0..1) controls the ankle pinch. Use after `humanoid_full ()` in the same scene.
module "humanoid_pants_tapered" (
  height=1.7,
  weight=1.0,
  taper=0.0,
  colour=[0.10, 0.10, 0.10]
) {
  material "pants_outer" (color=$colour, roughness=0.85)

  // Hips block — 2 mm offset all round so the outer pants sit just
  // proud of `humanoid_full`'s built-in hip geometry.
  chamfered_box "pants_hips" (
    pos=[0, $height * 0.485, 0],
    size=[$height * 0.194 * $weight, $height * 0.087, $height * 0.119 * $weight],
    radius=$height * 0.012,
    mat="pants_outer", skin="rig", bind="hip", faceted=1
  )

  // Thighs — straight tubes, 2 mm wider than the bare thigh so the outer
  // shell shows through cleanly.
  chamfered_box "pants_l_thigh" (
    pos=[$height *  0.060, $height * 0.375, 0],
    size=[$height * 0.066 * $weight, $height * 0.220, $height * 0.066 * $weight],
    radius=$height * 0.010,
    mat="pants_outer", skin="rig", bind="hip_l", faceted=1
  )
  chamfered_box "pants_r_thigh" (
    pos=[$height * -0.060, $height * 0.375, 0],
    size=[$height * 0.066 * $weight, $height * 0.220, $height * 0.066 * $weight],
    radius=$height * 0.010,
    mat="pants_outer", skin="rig", bind="hip_r", faceted=1
  )

  // Shins — taper-aware. At taper=0, ankle is the same width as the
  // current shin (0.056 * weight, ~2 mm wider than humanoid_full's
  // 0.052 baseline); at taper=1, ankle pinches to 60 % of the thigh
  // (0.0396 * weight) for a tailored break above the shoe.
  chamfered_box "pants_l_shin" (
    pos=[$height *  0.060, $height * 0.160, 0],
    size=[$height * (0.056 - 0.0164 * $taper) * $weight, $height * 0.220, $height * (0.056 - 0.0164 * $taper) * $weight],
    radius=$height * 0.009,
    mat="pants_outer", skin="rig", bind="knee_l", faceted=1
  )
  chamfered_box "pants_r_shin" (
    pos=[$height * -0.060, $height * 0.160, 0],
    size=[$height * (0.056 - 0.0164 * $taper) * $weight, $height * 0.220, $height * (0.056 - 0.0164 * $taper) * $weight],
    radius=$height * 0.009,
    mat="pants_outer", skin="rig", bind="knee_r", faceted=1
  )
}
