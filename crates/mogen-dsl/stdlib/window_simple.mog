// summary: Simple window: thin frame border + a thin glass pane. Authored bottom-anchored in the wall plane; +Z is the outside face. `width`/`height` should match the building opening.
module "window_simple" (width=1.2, height=1.4) {
  group "window_simple" {
    box "frame_top" (
      pos=[0, $height - 0.04, 0],
      size=[$width + 0.08, 0.08, 0.05]
    )
    box "frame_bottom" (
      pos=[0, 0.04, 0],
      size=[$width + 0.08, 0.08, 0.05]
    )
    box "frame_left" (
      pos=[$width * -0.5 + -0.02, $height * 0.5, 0],
      size=[0.04, $height, 0.05]
    )
    box "frame_right" (
      pos=[$width * 0.5 + 0.02, $height * 0.5, 0],
      size=[0.04, $height, 0.05]
    )
    // Centre mullion — visually breaks the pane up so the window doesn't
    // read as a flat panel even on small windows.
    box "mullion" (
      pos=[0, $height * 0.5, 0],
      size=[0.03, $height - 0.16, 0.04]
    )
    // Glass pane: very thin slab, will pick up the surrounding material
    // unless the caller provides a glass material override on the building.
    box "pane" (
      pos=[0, $height * 0.5, 0.0],
      size=[$width - 0.06, $height - 0.12, 0.01]
    )
  }
}
