// summary: Waist belt (thin chamfered_box ring + buckle block) for humanoid_full. Sits at the hip joint and follows the hip bone. Color defaults to dark leather; the buckle is brass-toned.
module "outfit_belt" (
  height=1.7,
  color=[0.18, 0.12, 0.08],
  buckle_color=[0.80, 0.65, 0.20]
) {
  material "outfit_belt"        (color=$color,        roughness=0.75)
  material "outfit_belt_buckle" (color=$buckle_color, roughness=0.40, metallic=0.6)

  group "outfit_belt" (skin="rig", bind="hip") {
    chamfered_box "outfit_belt_band" (
      pos=[0, $height * 0.580, 0],
      size=[$height * 0.214, $height * 0.025, $height * 0.124],
      radius=$height * 0.004,
      mat="outfit_belt", faceted=1
    )
    chamfered_box "outfit_belt_buckle" (
      pos=[0, $height * 0.580, $height * -0.064],
      size=[$height * 0.038, $height * 0.030, $height * 0.012],
      radius=$height * 0.002,
      mat="outfit_belt_buckle", faceted=1
    )
  }
}
