// summary: Hard helmet (chamfered_box cap + wedge brow visor) for humanoid_full. Sits over the head's crown, slightly oversized so the head shape reads through the bottom edge. Two color params: `color` (cap) and `visor_color` (forehead band). Bound to the `neck` bone so it tracks the head.
module "outfit_helmet" (
  height=1.7,
  color=[0.65, 0.66, 0.70],
  visor_color=[0.32, 0.34, 0.36]
) {
  material "outfit_helmet"       (color=$color,       roughness=0.45, metallic=0.7)
  material "outfit_helmet_visor" (color=$visor_color, roughness=0.40, metallic=0.7)

  group "outfit_helmet" (skin="rig", bind="neck") {
    // Cap dome — chamfered_box slightly larger than the head, sitting just
    // above the eye line so the painted face panel still reads.
    chamfered_box "outfit_helmet_cap" (
      pos=[0, $height * 0.965, 0],
      size=[$height * 0.118, $height * 0.090, $height * 0.118],
      radius=$height * 0.015,
      mat="outfit_helmet", faceted=1
    )
    // Forehead visor band — thin chamfered_box across the brow.
    chamfered_box "outfit_helmet_band" (
      pos=[0, $height * 0.940, $height * -0.054],
      size=[$height * 0.110, $height * 0.025, $height * 0.014],
      radius=$height * 0.004,
      mat="outfit_helmet_visor", faceted=1
    )
  }
}
