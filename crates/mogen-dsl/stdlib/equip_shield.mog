// summary: Round shield (chamfered_box body + cylindrical boss) for humanoid_full. Snaps onto the left hand's `wrist_l_grip` socket and follows the wrist_l bone. `color` controls the face, `boss_color` the central rivet.
module "equip_shield" (
  height=1.7,
  color=[0.45, 0.28, 0.16],
  boss_color=[0.72, 0.74, 0.78]
) {
  material "equip_shield_body" (color=$color,      roughness=0.75)
  material "equip_shield_boss" (color=$boss_color, roughness=0.35, metallic=0.8)

  // Shield held flat at the left hand, perpendicular to the body so it faces
  // -Z forward. Bound to wrist_l so it follows arm motion.
  group "equip_shield" (pos=[$height * 0.155, $height * 0.40, 0], skin="rig", bind="wrist_l") {
    // Shield body — wide chamfered_box, thin in -Z.
    chamfered_box "equip_shield_body" (
      pos=[0, 0, $height * -0.030],
      size=[$height * 0.190, $height * 0.230, $height * 0.020],
      radius=$height * 0.018,
      mat="equip_shield_body", faceted=1
    )
    // Central boss — cylindrical rivet projecting forward (-Z).
    cylinder "equip_shield_boss" (
      pos=[0, 0, $height * -0.046],
      rot=[90, 0, 0],
      radius=$height * 0.022,
      height=$height * 0.012,
      segments=12,
      mat="equip_shield_boss", faceted=1
    )
  }
}
